package uveddi:plugins@0.1.0;

interface types {
    // Core data types for analysis
    record dependency {
        from-module: string,
        to-module: string,
        dependency-type: string,
    }

    record architectural-issue {
        file-path: string,
        start-line: u32,
        end-line: u32,
        issue-type: string,
        severity: string,
        message: string,
        code-snippet: option<string>,
    }

    // Plugin metadata
    record plugin-info {
        name: string,
        version: string,
        description: string,
        author: string,
    }
}

interface logging {
    log: func(level: string, message: string);
}

interface config {
    get-value: func(key: string) -> option<string>;
}

interface plugin-api {
    use types.{dependency, architectural-issue, plugin-info};
    
    info: func() -> plugin-info;
    analyze: func(dependencies: list<dependency>) -> list<architectural-issue>;
}

// Main plugin interface
world plugin {
    import logging;
    import config;
    export plugin-api;
}