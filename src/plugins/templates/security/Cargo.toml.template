[package]
name = "{PLUGIN_ID_SNAKE}_security_plugin"
version = "{VERSION}"
edition = "2021"
authors = ["{AUTHOR}"]
license = "{LICENSE}"
description = "{PLUGIN_DESCRIPTION}"
repository = "https://github.com/your-org/plugins/{PLUGIN_ID}"
readme = "README.md"
keywords = ["uveddi", "plugin", "security", "vulnerability", "analysis"]
categories = ["development-tools", "cryptography"]

[lib]
crate-type = ["cdylib"]

[dependencies]
wit-bindgen = "0.30.0"

[package.metadata.component]
package = "your-org:{PLUGIN_ID}"

[package.metadata.component.dependencies]
"wasi:cli" = { path = "wit/deps/cli" }

[profile.release]
lto = true
strip = true
codegen-units = 1
panic = "abort"

[profile.dev]
opt-level = 1