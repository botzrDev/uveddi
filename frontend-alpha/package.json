{
  "name": "frontend-alpha",
  "private": true,
  "version": "0.9.0-alpha",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:analyze": "tsc -b && vite build --mode analyze",
    "lint": "eslint .",
    "lint:alpha": "eslint . --config .eslintrc.alpha.cjs",
    "preview": "vite preview",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:headed": "cypress run --headed",
    "cy:run:chrome": "cypress run --browser chrome",
    "cy:run:firefox": "cypress run --browser firefox",
    "cy:run:headless": "cypress run --headless --browser electron",
    "test:e2e": "start-server-and-test dev http://localhost:9998 cy:run",
    "test:e2e:open": "start-server-and-test dev http://localhost:9998 cy:open",
    "test:e2e:headless": "start-server-and-test dev http://localhost:9998 cy:run:headless",
    "test:component": "cypress run --component",
    "test:all": "npm run test:e2e:headless && npm run test:component",
    "test:ci": "npm run build && npm run test:all"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.81.5",
    "@types/d3": "^7.4.3",
    "@types/gsap": "^1.20.2",
    "@types/node": "^24.0.8",
    "axios": "^1.10.0",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "d3-zoom": "^3.0.0",
    "date-fns": "^4.1.0",
    "gsap": "^3.13.0",
    "lucide-react": "^0.525.0",
    "mermaid": "^11.9.0",
    "prism-themes": "^1.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.6.3",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "y-indexeddb": "^9.0.12",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.27",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@cypress/react": "^9.0.1",
    "@eslint/js": "^9.29.0",
    "@testing-library/cypress": "^10.0.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "autoprefixer": "^10.4.21",
    "cypress": "^14.5.3",
    "cypress-real-events": "^1.14.0",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^5.12.0",
    "start-server-and-test": "^2.0.12",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^7.0.0",
    "web-vitals": "^4.2.4"
  }
}
