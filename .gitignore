# Rust build artifacts
/target/
**/*.rs.bk
**/debug/
/target/incremental/

# Cache directories (runtime caches, not source code)
/cache/

# Local test fixtures (real-world codebases fetched for detector validation;
# not tracked — were previously committed as broken submodule gitlinks)
/test-codebases/

# IDE/editor settings
/.vscode/
.idea/
*.swp
*.swo
*.sublime*
.DS_Store

# Dependency/package manager files
Cargo.lock

# Logs and temporary files
*.log
*.tmp
*.bak
*.old

# Ignore generated reports and diagrams
*.md.report
*.diagram

# Ignore by analysis tools
.archlintignore

# Ignore Rust Analyzer metadata
/.rust-analyzer/

# Ignore docs build artifacts (if any)
/docs/book/

# Ignore local SQLite database and related files
.uveddi/
.uveddi_cache/
*.db
uveddi_cache.db
**/tmp_*
# Cache directories
/cache/
# Ignore PID files from scripts
/scripts/*.pid

# Python
backend/venv/
backend/__pycache__/
backend/*.pyc
backend/*.pyo
backend/*.pyd
backend/.pytest_cache/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

