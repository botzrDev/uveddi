# Multi-stage production-optimized Dockerfile for Uveddi Analysis Engine
# Optimized for performance, security, and minimal attack surface

# ==================== BUILD STAGE ====================
FROM rust:1.82-alpine AS builder

# Install build dependencies
RUN apk add --no-cache \
    musl-dev \
    openssl-dev \
    pkgconfig \
    git \
    make \
    g++ \
    ca-certificates \
    upx

WORKDIR /build

# Create cache mount points for optimal layer caching
COPY Cargo.toml Cargo.lock ./
RUN mkdir -p src && \
    echo "fn main() {}" > src/main.rs && \
    cargo build --release --features full && \
    rm -rf src

# Copy source code and build optimized binary
COPY . .
RUN cargo build --release --features full && \
    strip target/release/uveddi && \
    upx --lzma target/release/uveddi

# ==================== RUNTIME STAGE ====================
FROM alpine:3.20 AS runtime

# Install runtime dependencies
RUN apk add --no-cache \
    ca-certificates \
    tzdata \
    tini

# Create non-root user for security
RUN addgroup -g 1001 uveddi && \
    adduser -D -s /bin/sh -u 1001 -G uveddi uveddi

# Set up directories with proper permissions
RUN mkdir -p /app/data /app/cache /app/logs /app/config && \
    chown -R uveddi:uveddi /app

# Copy optimized binary
COPY --from=builder /build/target/release/uveddi /app/bin/uveddi
RUN chmod +x /app/bin/uveddi

# Copy configuration templates
COPY --chown=uveddi:uveddi docker/config/production.yaml /app/config/default.yaml
COPY --chown=uveddi:uveddi docker/scripts/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Switch to non-root user
USER uveddi
WORKDIR /app

# Health check configuration
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD /app/bin/uveddi health || exit 1

# Resource limits and metadata
LABEL org.opencontainers.image.title="Uveddi Analysis Engine" \
      org.opencontainers.image.description="High-performance code analysis with 2-30x cache speedup" \
      org.opencontainers.image.version="0.9.0-alpha" \
      org.opencontainers.image.vendor="Uveddi Project" \
      maintainer="Austin Green"

# Expose API port
EXPOSE 8080

# Use tini as PID 1 for proper signal handling
ENTRYPOINT ["/sbin/tini", "--", "/app/entrypoint.sh"]
CMD ["serve", "--config", "/app/config/default.yaml"]