# Ultra-fast development environment
VITE_FAST_BUILD=true
VITE_SKIP_COVERAGE=true
VITE_DISABLE_ANALYTICS=true
VITE_SKIP_TYPE_CHECK=true

# Minimal dev server settings
VITE_DEV_PORT=8001
VITE_API_BASE_URL=http://localhost:8000

# Performance optimization flags (disabled for speed)
VITE_ENABLE_DEVTOOLS=false
VITE_ENABLE_HMR=false
VITE_ENABLE_SOURCEMAPS=false