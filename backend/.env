# Environment configuration for CodeAtlas backend

# Database Configuration
DB_POSTGRES_HOST=localhost
DB_POSTGRES_PORT=5433
DB_POSTGRES_USER=codeatlas
DB_POSTGRES_PASSWORD=codeatlas
DB_POSTGRES_DB=codeatlas
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ENVIRONMENT=development

# Application Configuration
APP_NAME=CodeAtlas Backend
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# JWT Authentication
JWT_SECRET_KEY=change_this_to_secure_secret_key_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# For Google Cloud SQL (uncomment and configure for production)
# GOOGLE_CLOUD_PROJECT=your-project-id
# CLOUD_SQL_CONNECTION_NAME=your-project:region:instance
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-file.json
