{
  "dashboard": {
    "id": null,
    "title": "Uveddi Analysis Engine - Production Dashboard",
    "description": "Production monitoring dashboard for Uveddi high-performance analysis engine with cache metrics",
    "tags": ["uveddi", "analysis", "performance", "cache"],
    "timezone": "UTC",
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },

    "panels": [
      {
        "id": 1,
        "title": "🚀 Cache Performance Overview",
        "type": "stat",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "rate(uveddi_cache_hits_total[5m]) / rate(uveddi_cache_requests_total[5m])",
            "legendFormat": "Cache Hit Rate"
          },
          {
            "expr": "avg(uveddi_analysis_speedup_factor)",
            "legendFormat": "Performance Speedup"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 0.75},
                {"color": "green", "value": 0.85}
              ]
            }
          }
        }
      },

      {
        "id": 2,
        "title": "📈 Analysis Throughput",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "rate(uveddi_analyses_completed_total[5m])",
            "legendFormat": "Analyses per second"
          },
          {
            "expr": "rate(uveddi_files_processed_total[5m])",
            "legendFormat": "Files per second"
          }
        ],
        "yAxes": [
          {"label": "Operations/sec", "min": 0}
        ]
      },

      {
        "id": 3,
        "title": "💾 Cache Layer Statistics",
        "type": "table",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "uveddi_cache_entries_current",
            "legendFormat": "{{layer}}"
          },
          {
            "expr": "rate(uveddi_cache_hits_total[5m])",
            "legendFormat": "{{layer}}_hits"
          },
          {
            "expr": "rate(uveddi_cache_misses_total[5m])",
            "legendFormat": "{{layer}}_misses"
          },
          {
            "expr": "uveddi_cache_memory_bytes / 1024 / 1024",
            "legendFormat": "{{layer}}_memory_mb"
          }
        ],
        "transform": "table",
        "columns": [
          {"text": "Cache Layer", "value": "layer"},
          {"text": "Entries", "value": "entries"},
          {"text": "Hit Rate", "value": "hit_rate", "unit": "percentunit"},
          {"text": "Memory (MB)", "value": "memory_mb", "unit": "bytes"}
        ]
      },

      {
        "id": 4,
        "title": "🔥 System Resource Usage",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "rate(process_cpu_seconds_total[5m]) * 100",
            "legendFormat": "CPU Usage %"
          },
          {
            "expr": "process_resident_memory_bytes / 1024 / 1024",
            "legendFormat": "Memory Usage (MB)"
          }
        ],
        "yAxes": [
          {"label": "Usage", "min": 0}
        ]
      },

      {
        "id": 5,
        "title": "⚡ WebSocket Connections",
        "type": "singlestat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 16},
        "targets": [
          {
            "expr": "uveddi_websocket_connections_active",
            "legendFormat": "Active Connections"
          }
        ],
        "valueName": "current",
        "colorValue": true,
        "thresholds": "50,100"
      },

      {
        "id": 6,
        "title": "📊 Analysis Queue Depth",
        "type": "singlestat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 16},
        "targets": [
          {
            "expr": "uveddi_analysis_queue_length",
            "legendFormat": "Queue Length"
          }
        ],
        "valueName": "current",
        "colorValue": true,
        "thresholds": "10,20"
      },

      {
        "id": 7,
        "title": "🚨 Error Rates",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
        "targets": [
          {
            "expr": "rate(uveddi_errors_total[5m])",
            "legendFormat": "{{error_type}}"
          },
          {
            "expr": "rate(uveddi_http_requests_total{status=~\"5..\"}[5m])",
            "legendFormat": "HTTP 5xx Errors"
          }
        ],
        "alert": {
          "conditions": [
            {
              "query": {"params": ["A", "5m", "now"]},
              "reducer": {"type": "avg"},
              "evaluator": {"params": [0.01], "type": "gt"}
            }
          ],
          "frequency": "10s",
          "name": "High Error Rate Alert"
        }
      },

      {
        "id": 8,
        "title": "⏱️ Response Time Percentiles",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(uveddi_request_duration_seconds_bucket[5m]))",
            "legendFormat": "50th percentile"
          },
          {
            "expr": "histogram_quantile(0.95, rate(uveddi_request_duration_seconds_bucket[5m]))",
            "legendFormat": "95th percentile"
          },
          {
            "expr": "histogram_quantile(0.99, rate(uveddi_request_duration_seconds_bucket[5m]))",
            "legendFormat": "99th percentile"
          }
        ],
        "yAxes": [
          {"label": "Seconds", "min": 0}
        ]
      }
    ],

    "templating": {
      "list": [
        {
          "name": "instance",
          "type": "query",
          "query": "label_values(uveddi_cache_hits_total, instance)",
          "refresh": 1
        },
        {
          "name": "cache_layer",
          "type": "query",
          "query": "label_values(uveddi_cache_entries_current, layer)",
          "refresh": 1,
          "multi": true,
          "includeAll": true
        }
      ]
    },

    "annotations": {
      "list": [
        {
          "name": "Deployments",
          "datasource": "prometheus",
          "expr": "changes(uveddi_build_info[1h])",
          "titleFormat": "Deployment",
          "textFormat": "Version: {{version}}"
        }
      ]
    },

    "links": [
      {
        "title": "Uveddi Documentation",
        "url": "https://docs.uveddi.com/monitoring",
        "type": "link"
      },
      {
        "title": "Performance Runbook",
        "url": "https://runbooks.uveddi.com/performance",
        "type": "link"
      }
    ]
  }
}