{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "cargo build",
			"type": "shell",
			"command": "cargo",
			"args": [
				"build"
			],
			"group": "build",
			"problemMatcher": [
				"$rustc"
			],
			"isBackground": false
		},
		{
			"label": "cargo run",
			"type": "shell",
			"command": "cargo",
			"args": [
				"run"
			],
			"group": "build",
			"problemMatcher": [
				"$rustc"
			],
			"isBackground": false
		},
		{
			"label": "cargo test",
			"type": "shell",
			"command": "cargo",
			"args": [
				"test"
			],
			"group": "test",
			"problemMatcher": [
				"$rustc"
			],
			"isBackground": false
		},
		{
			"label": "Run TUI",
			"type": "shell",
			"command": "cargo",
			"args": ["run", "--bin", "tui_test", "--features", "tui"],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": true,
				"panel": "new"
			},
			"problemMatcher": []
		}
	]
}