# Uveddi Production Release Dockerfile
# Multi-stage build for minimal, secure container images
#
# Build: docker build -f Dockerfile.release -t uveddi:1.0.0 .
# Scan: trivy image uveddi:1.0.0
# Run: docker run --rm uveddi:1.0.0 --version

# ============================================================================
# Stage 1: Builder
# ============================================================================
FROM rust:1.75-slim-bookworm AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    musl-tools \
    && rm -rf /var/lib/apt/lists/*

# Add musl target for static linking
RUN rustup target add x86_64-unknown-linux-musl

# Create app directory
WORKDIR /build

# Copy dependency files first for better caching
COPY Cargo.toml Cargo.lock ./
COPY build.rs ./

# Create dummy source to build dependencies
RUN mkdir -p src && \
    echo "fn main() {}" > src/main.rs && \
    cargo build --release --target x86_64-unknown-linux-musl --features cli-standard

# Remove dummy source
RUN rm -rf src

# Copy actual source code
COPY src ./src
COPY templates ./templates
COPY wit ./wit

# Build the actual application
RUN cargo build --release --target x86_64-unknown-linux-musl --features cli-standard

# Strip the binary to reduce size
RUN strip /build/target/x86_64-unknown-linux-musl/release/uveddi

# ============================================================================
# Stage 2: Runtime (Distroless)
# ============================================================================
FROM gcr.io/distroless/static-debian12:nonroot AS runtime

# Copy the binary from builder
COPY --from=builder /build/target/x86_64-unknown-linux-musl/release/uveddi /usr/local/bin/uveddi

# Set up non-root user (distroless nonroot is UID 65532)
USER nonroot:nonroot

# Create volume for data
VOLUME ["/data"]

# Set working directory
WORKDIR /data

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD ["/usr/local/bin/uveddi", "--version"]

# Metadata
LABEL org.opencontainers.image.title="Uveddi"
LABEL org.opencontainers.image.description="Rust-based code analysis and exploration tool"
LABEL org.opencontainers.image.version="1.0.0"
LABEL org.opencontainers.image.vendor="Uveddi Project"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.url="https://github.com/botzrDev/uveddi"
LABEL org.opencontainers.image.documentation="https://uveddi.io/docs"
LABEL org.opencontainers.image.source="https://github.com/botzrDev/uveddi"

# Default command
ENTRYPOINT ["/usr/local/bin/uveddi"]
CMD ["--help"]

# ============================================================================
# Stage 3: Runtime (Alpine - alternative for debugging)
# ============================================================================
FROM alpine:3.19 AS runtime-alpine

# Install runtime dependencies only
RUN apk add --no-cache \
    ca-certificates \
    libgcc \
    && addgroup -g 10001 uveddi \
    && adduser -D -u 10001 -G uveddi uveddi

# Copy the binary from builder
COPY --from=builder /build/target/x86_64-unknown-linux-musl/release/uveddi /usr/local/bin/uveddi

# Set ownership
RUN chown uveddi:uveddi /usr/local/bin/uveddi

# Switch to non-root user
USER uveddi:uveddi

# Create volume for data
VOLUME ["/data"]

# Set working directory
WORKDIR /data

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD ["/usr/local/bin/uveddi", "--version"]

# Metadata
LABEL org.opencontainers.image.title="Uveddi (Alpine)"
LABEL org.opencontainers.image.description="Rust-based code analysis and exploration tool (Alpine variant)"
LABEL org.opencontainers.image.version="1.0.0"
LABEL org.opencontainers.image.vendor="Uveddi Project"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.url="https://github.com/botzrDev/uveddi"
LABEL org.opencontainers.image.documentation="https://uveddi.io/docs"
LABEL org.opencontainers.image.source="https://github.com/botzrDev/uveddi"

# Default command
ENTRYPOINT ["/usr/local/bin/uveddi"]
CMD ["--help"]
