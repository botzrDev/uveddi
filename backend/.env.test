# Test environment configuration for CodeAtlas backend

# Database Configuration
DB_POSTGRES_HOST=localhost
DB_POSTGRES_PORT=5433  # Using Docker-mapped port
DB_POSTGRES_USER=codeatlas
DB_POSTGRES_PASSWORD=codeatlas
DB_POSTGRES_DB=codeatlas  # Using the default DB from docker-compose
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ENVIRONMENT=test

# Application Configuration
APP_NAME=CodeAtlas Test
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8001
APP_DEBUG=true

# Security Configuration
SECRET_KEY=test_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging Configuration
LOG_LEVEL=DEBUG
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
