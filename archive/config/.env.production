# Production Environment Configuration
NODE_ENV=production
RUST_ENV=production

# API Configuration
API_URL=https://api.uveddi.com/api/v1
FRONTEND_URL=https://uveddi.com
API_PORT=8080
METRICS_PORT=9090
RENDERING_SERVICE_PORT=3001

# Database Configuration
DATABASE_URL=postgresql://uveddi_user:${DB_PASSWORD}@postgres-service:5432/uveddi_prod
DATABASE_POOL_SIZE=20
DATABASE_MAX_CONNECTIONS=100

# Redis Configuration
REDIS_URL=redis://redis-service:6379
REDIS_POOL_SIZE=10
CACHE_TTL=3600

# Security Configuration
JWT_SECRET=${JWT_SECRET}
API_KEY=${API_KEY}
CORS_ORIGINS=https://uveddi.com,https://api.uveddi.com
SECURE_COOKIES=true
CSRF_PROTECTION=true

# Logging Configuration
LOG_LEVEL=info
RUST_LOG=info,uveddi=debug
RUST_BACKTRACE=1
LOG_FORMAT=json

# Monitoring
METRICS_ENABLED=true
PROMETHEUS_PORT=9090
TRACING_ENABLED=true
JAEGER_ENDPOINT=http://jaeger:14268/api/traces

# Performance Tuning
WORKER_THREADS=8
MAX_CONNECTIONS=1000
REQUEST_TIMEOUT=30
ANALYSIS_TIMEOUT=300
MAX_MEMORY_MB=2048
CACHE_SIZE_MB=512

# Feature Flags
FEATURE_AI_ANALYSIS=true
FEATURE_SECURITY_SCANNING=true
FEATURE_WASM_PLUGINS=true
FEATURE_TEAM_COLLABORATION=true

# External Services
GITHUB_API_TOKEN=${GITHUB_API_TOKEN}
SLACK_WEBHOOK_URL=${SLACK_WEBHOOK_URL}
SENTRY_DSN=${SENTRY_DSN}

# Storage
UPLOAD_DIR=/app/uploads
CACHE_DIR=/app/cache
LOG_DIR=/app/logs
MAX_UPLOAD_SIZE=104857600  # 100MB

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_S3_BUCKET=${BACKUP_S3_BUCKET}
BACKUP_RETENTION_DAYS=30