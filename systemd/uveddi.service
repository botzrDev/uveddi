# Systemd service configuration for Uveddi
# Place this file at: /etc/systemd/system/uveddi.service

[Unit]
Description=Uveddi Code Analysis Platform
Documentation=https://docs.uveddi.com
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=exec
User=uveddi
Group=uveddi
ExecStart=/home/austingreen/Documents/botzr/projects/uveddi/scripts/process-manager.sh start
ExecStop=/home/austingreen/Documents/botzr/projects/uveddi/scripts/process-manager.sh stop
ExecReload=/home/austingreen/Documents/botzr/projects/uveddi/scripts/process-manager.sh restart

# Health monitoring
ExecStartPost=/bin/sleep 10
ExecStartPost=/home/austingreen/Documents/botzr/projects/uveddi/scripts/process-manager.sh health

# Restart behavior
Restart=on-failure
RestartSec=10
StartLimitInterval=300
StartLimitBurst=5

# Timeouts
TimeoutStartSec=120
TimeoutStopSec=60

# Working directory
WorkingDirectory=/home/austingreen/Documents/botzr/projects/uveddi

# Environment
Environment=NODE_ENV=production
Environment=RUST_LOG=info
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/node/bin
EnvironmentFile=-/etc/uveddi/environment

# Security settings
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/austingreen/Documents/botzr/projects/uveddi/logs
ReadWritePaths=/home/austingreen/Documents/botzr/projects/uveddi/.pids
ReadWritePaths=/home/austingreen/Documents/botzr/projects/uveddi/cache
ReadWritePaths=/tmp
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
LimitMEMLOCK=64M

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=uveddi

[Install]
WantedBy=multi-user.target
