# Rust build artifacts
/target/
**/*.rs.bk

# IDE/editor settings
/.vscode/
.idea/
*.swp
*.swo
*.sublime*
.DS_Store

# Dependency/package manager files
Cargo.lock

# Logs and temporary files
*.log
*.tmp
*.bak
*.old

# Ignore generated reports and diagrams
*.md.report
*.diagram

# Ignore by analysis tools
.archlintignore

# Ignore Rust Analyzer metadata
/.rust-analyzer/

# Ignore docs build artifacts (if any)
/docs/book/

# Ignore local SQLite database and related files
.uveddi/
.uveddi_cache/
*.db

# Ignore PID files from scripts
/scripts/*.pid

# Python
backend/venv/
backend/__pycache__/
backend/*.pyc
backend/*.pyo
backend/*.pyd
backend/.pytest_cache/

# Node.js/Frontend
node_modules/
dist/
dist-ssr/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/

# Misc
*.bin
*.exe
*.out
*.so
*.dll
*.dylib

# Uncomment if config/ or plugins/ contain only generated or environment-specific files.
# /config/
# /plugins/
