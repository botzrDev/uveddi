package botzr:uveddi-policy-engine-plugin;

// Policy engine interface
world policy-engine {
    // Represents an architectural decision to be evaluated
    type decision = string;

    // Result of a policy evaluation
    variant policy-result {
        allowed,
        denied,
        error(string),
    }

    // Evaluates a decision against architectural policies
    export check-policy: func(decision: decision) -> policy-result;
}
