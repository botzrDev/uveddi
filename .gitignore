# Rust build artifacts
/target
**/*.rs.bk

# IDE/editor settings
/.vscode/
.idea/
*.swp
*.swo
*.sublime*
.DS_Store

# Dependency/package manager files
Cargo.lock

# Logs and temporary files
*.log
*.tmp
*.bak
